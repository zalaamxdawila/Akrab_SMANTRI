# Copy these names into the hosting environment configuration.
# Never put real passwords or registration codes in this file.

AKRAB_APP_ENV=production
AKRAB_BASE_URL=https://example.invalid/

AKRAB_DB_HOST=localhost
AKRAB_DB_NAME=database_name
AKRAB_DB_USER=database_user
AKRAB_DB_PASS=replace_with_hosting_secret

# Used only by the CLI migration tool. This account may alter schema.
AKRAB_MIGRATION_DB_USER=migration_database_user
AKRAB_MIGRATION_DB_PASS=replace_with_separate_migration_secret

AKRAB_SESSION_IDLE_SECONDS=1800
AKRAB_SESSION_ABSOLUTE_SECONDS=28800

CLINICAL_RISK_ENABLED=false
AKRAB_UKS_REGISTRATION_CODE=replace_with_rotatable_secret

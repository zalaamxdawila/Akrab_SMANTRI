<?xml version="1.0" encoding="utf-8"?>
<widget id="com.portodq.akrab"
        version="1.0.0"
        android-versionCode="10000"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
    <name>AKRAB</name>
    <description>Aplikasi skrining gejala dan pendampingan pencegahan anemia untuk remaja di sekolah.</description>
    <author href="https://akrab.portodq.com/">SMAN 3 Padang</author>

    <content src="https://akrab.portodq.com/" />

    <access origin="https://akrab.portodq.com" />
    <access origin="https://fonts.googleapis.com" />
    <access origin="https://fonts.gstatic.com" />
    <access origin="https://ssl.gstatic.com" />
    <allow-navigation href="https://akrab.portodq.com/*" />

    <preference name="AndroidInsecureFileModeEnabled" value="false" />
    <preference name="InspectableWebview" value="false" />
    <preference name="loglevel" value="ERROR" />
    <preference name="AndroidLaunchMode" value="singleTask" />
    <preference name="AllowNewWindows" value="false" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="LoadUrlTimeoutValue" value="30000" />
    <preference name="ErrorUrl" value="offline.html" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xfff8f9fa" />
    <preference name="AndroidWindowSplashScreenBackground" value="#f8f9fa" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.png" />
        <icon src="res/icon.png" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="false"
                         android:allowBackup="false"
                         android:fullBackupContent="false" />
        </edit-config>
    </platform>
</widget>
